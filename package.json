{
  "name": "@otto-assistant/opencode-cursor-auth",
  "version": "3.0.0",
  "description": "Stateless Cursor OAuth provider for OpenCode with images and OpenCode-owned tool loops.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test/*.test.ts",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasualDeveloper/opencode-cursor-auth.git"
  },
  "homepage": "https://github.com/CasualDeveloper/opencode-cursor-auth#readme",
  "bugs": {
    "url": "https://github.com/CasualDeveloper/opencode-cursor-auth/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "oauth",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.7"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  }
}
