{
  "name": "@otto-assistant/opencode-cursor-oauth",
  "version": "3.0.0-beta.2",
  "description": "Cursor private models in OpenCode 2 — native OAuth, live catalog discovery, images, tools, and agent-grade streaming.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "bun test/smoke.ts",
    "test:v2": "bun test test/v2-*.test.ts test/node-runtime.test.ts test/model-normalizer.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "test:v2-loader": "node scripts/smoke-opencode-v2.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm test && npm run test:v2 && npm run typecheck && npm run build && npm run test:package && npm run test:v2-loader",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otto-assistant/opencode-cursor.git"
  },
  "homepage": "https://www.npmjs.com/package/@otto-assistant/opencode-cursor-oauth",
  "bugs": {
    "url": "https://github.com/otto-assistant/opencode-cursor/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "cursor-pro",
    "oauth",
    "openai-compatible",
    "ai",
    "llm",
    "streaming",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@bufbuild/protobuf": "^2.0.0",
    "@opencode-ai/plugin": "0.0.0-beta-18050",
    "@opencode-ai/plugin-v1": "npm:@opencode-ai/plugin@1.15.7",
    "@opencode-ai/schema": "0.0.0-beta-18050"
  },
  "devDependencies": {
    "@opencode-ai/cli": "0.0.0-beta-18050",
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@opencode-ai/cli"
  ]
}
