{
  "name": "@otto-assistant/opencode-cursor-oauth",
  "version": "3.0.0-beta.2",
  "description": "Cursor private models in OpenCode 2 — native OAuth, live catalog discovery, images, tools, and agent-grade streaming.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "test": "bun test test/v2-*.test.ts test/auth.test.ts test/cursor-rpc.test.ts test/model-selection.test.ts test/node-runtime.test.ts test/model-normalizer.test.ts test/shared-constants.test.ts",
    "test:v2": "npm test",
    "test:cursor-capability": "tsc -p tsconfig.cursor-capability.json && bun build ./test/cursor-capability.test.ts --target=node --outfile=node_modules/.cache/cursor-capability-test.mjs && node node_modules/.cache/cursor-capability-test.mjs",
    "probe:cursor-capability": "bun build ./scripts/probe-opencode-v2-cursor.ts --target=node --outfile=node_modules/.cache/cursor-capability-probe.mjs && node node_modules/.cache/cursor-capability-probe.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:v2-loader": "node scripts/smoke-opencode-v2.mjs",
    "test:v2-host": "node scripts/test-opencode-v2-host.mjs",
    "test:v2-probe": "node scripts/test-opencode-v2-probe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:fixtures": "tsc -p tsconfig.host-fixtures.json",
    "verify": "npm test && npm run test:cursor-capability && npm run typecheck && npm run build && npm run typecheck:fixtures && npm run test:v2-host && npm run test:v2-probe && npm run test:package && npm run test:v2-loader",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otto-assistant/opencode-cursor.git"
  },
  "homepage": "https://www.npmjs.com/package/@otto-assistant/opencode-cursor-oauth",
  "bugs": {
    "url": "https://github.com/otto-assistant/opencode-cursor/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "cursor-pro",
    "oauth",
    "ai",
    "llm",
    "streaming",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@bufbuild/protobuf": "^2.14.1",
    "@opencode/plugin": "2.0.6",
    "@opencode/schema": "2.0.6"
  },
  "devDependencies": {
    "@opencode/cli": "2.0.6",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
